# Frontend (filled by `npx convex dev`)
VITE_CONVEX_URL=

# Evidence / process:getLive — fleet-gerbil-682 ONLY (never quirky)
VITE_EVIDENCE_CONVEX_URL=https://fleet-gerbil-682.convex.cloud

# Public inbox — not a secret
AGENTMAIL_INBOX_ID=ceilinggate-claims@agentmail.to
AGENTMAIL_INBOX_EMAIL=ceilinggate-claims@agentmail.to

# App secrets live on the Convex deployment only.
# Set them in dashboard Settings → Environment Variables
# or: npx convex env set NAME   (interactive, no value on argv)
#
# FIRECRAWL_API_KEY
# FIRECRAWL_WEBHOOK_SECRET
# AGENTMAIL_API_KEY
# AGENTMAIL_WEBHOOK_SECRET
# OPENAI_API_KEY
#
# CI only (GitHub Actions secret, never committed):
# CONVEX_DEPLOY_KEY

# Static fortress (browser + firewall crawl) — NOT the Convex client API
VITE_PUBLIC_SITE_URL=https://quirky-rhinoceros-204.convex.site

# Static fortress crawl base (Convex sets CONVEX_SITE_URL on deploy automatically).
# Do NOT point VITE_CONVEX_URL at *.convex.site — TWO-HOST LAW.
# Optional local alias (frontend public site); crawl engine uses CONVEX_SITE_URL:
# NEXT_PUBLIC_CONVEX_SITE_URL=https://quirky-rhinoceros-204.convex.site
# CONVEX_SITE_URL is used by convex/firewallCrawl.ts (fallback: quirky-rhinoceros-204.convex.site)

